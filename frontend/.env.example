# Backend base URL (no trailing slash). In development the Vite proxy forwards /api and /r/.
VITE_BACKEND_URL=https://your-backend.onrender.com
# Optional: domain used when displaying/copying short links (e.g. your Vercel or custom domain,
# which proxies /r/* to the backend via vercel.json). Defaults to VITE_BACKEND_URL.
VITE_SHORT_LINK_BASE_URL=
