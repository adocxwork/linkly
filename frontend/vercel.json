{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://linkly-amwf.onrender.com/api/$1"
    },
    {
      "source": "/r/(.*)",
      "destination": "https://linkly-amwf.onrender.com/r/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
