# Backend environment variables. Copy to .env for local runs (./run.sh loads it).
# On Render, set these in Dashboard -> your service -> Environment.

# PostgreSQL (Supabase "Session pooler" connection, JDBC format)
DB_URL=jdbc:postgresql://localhost:5432/linkly
DB_USERNAME=postgres
DB_PASSWORD=

# Redis (Upstash, rediss:// URL). Leave empty to run without Redis.
REDIS_URL=

# At least 32 random characters, e.g. output of: openssl rand -hex 32
JWT_SECRET=

# Frontend origin, used for CORS and the "link unavailable" redirect
FRONTEND_URL=http://localhost:5173

# Creates the admin account on first start (only if no admin exists yet)
ADMIN_PASSWORD=

# Number of reverse proxies in front of the app (Render = 1; 0 for local runs without a proxy)
TRUSTED_PROXY_COUNT=0
